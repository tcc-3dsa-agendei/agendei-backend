{
  "name": "agendei-backend",
  "module": "src/server.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/bun": "1.3.14",
    "@types/pg": "8.20.0",
    "prisma": "7.8.0"
  },
  "peerDependencies": {
    "typescript": "6.0.3",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "better-auth": "1.6.11",
    "dedent": "1.7.2",
    "@brazilian-utils/brazilian-utils": "2.3.0",
    "pg": "8.21.0",
    "zod": "4.4.3"
  },
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "db:generate": "bunx --bun prisma generate",
    "db:migrate": "bunx --bun prisma migrate dev --name init",
    "db:studio": "bunx --bun prisma studio"
  },
  "packageManager": "bun",
  "dependencies": {
    "@better-fetch/fetch": "1.1.21",
    "@elysiajs/cors": "1.4.2",
    "elysia": "1.4.28"
  }
}
